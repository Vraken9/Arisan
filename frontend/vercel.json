{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/pitch-deck", "destination": "/pitch-deck.html" },
    { "source": "/pitch-deck.html", "destination": "/pitch-deck.html" },
    { "source": "/((?!pitch-deck).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
