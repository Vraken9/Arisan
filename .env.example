# === ArisanChain Environment Variables ===

# Private key wallet utama (JANGAN gunakan wallet mainnet!)
PRIVATE_KEY=0x_your_private_key_here

# Private keys untuk wallet demo tambahan (opsional, untuk demo script)
WALLET_2_KEY=0x_second_wallet_key
WALLET_3_KEY=0x_third_wallet_key

# API Key dari BscScan (untuk verifikasi kontrak)
# Dapatkan di: https://testnet.bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key_here
