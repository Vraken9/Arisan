{
  "name": "arisan-chain",
  "version": "1.0.0",
  "description": "ArisanChain — Digitalisasi Arisan di BNB Chain (Indonesia Web3 Hackathon 2026)",
  "main": "index.js",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "demo": "npx hardhat run scripts/demo.js",
    "deploy:testnet": "npx hardhat run scripts/deploy.js --network bscTestnet",
    "mint:testnet": "npx hardhat run scripts/mint-tokens.js --network bscTestnet",
    "frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "arisan",
    "blockchain",
    "bnb-chain",
    "web3",
    "hackathon"
  ],
  "author": "ArisanChain Team",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "dotenv": "^18.0.4",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
